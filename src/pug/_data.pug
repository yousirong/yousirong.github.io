      title: 'Multimodal Diffusion Transformer for 3D Brain Image Generation and Diagnostic Classification in Alzheimer\'s Disease Progression',
      authors: [],
      venue: 'IEEE/CVF Winter Conference on Applications of Computer Vision',
      short: 'WACV 2027',
      detail: 'WACV 2027',
      status: 'submitted',
      period: '1st Semester 2026',
